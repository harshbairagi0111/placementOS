    "test:memory": "tsx scripts/test-conversational-memory.ts",
    "test:ai-mentor-rag": "tsx scripts/test-ai-mentor-rag.ts",
    "test:rag-guardrails": "tsx scripts/test-rag-guardrails.ts",
    "evaluate:rag": "tsx scripts/evaluate-rag-retrieval.ts",
    "test:tab-switch": "tsx scripts/test-interview-tab-switch.ts",
    "test:rule-4": "tsx scripts/test-multiple-proctoring-violations.ts",
    "seed:coding": "tsx scripts/seedCodingQuestions.ts",
    "test:coding-dataset": "tsx scripts/validateCodingDataset.ts",
    "test:coding": "tsx scripts/test-coding-api-security.ts",
